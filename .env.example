OPENAI_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

PROBE_DIAGNOSTICS=false

# Async SQLAlchemy URL. Override this with the remote database URL when deployed.
PROBE_DATABASE_URL=postgresql+asyncpg://probe:probe@localhost:5432/probe

# Optional Compose overrides. The container URL defaults to the Compose database.
PROBE_CONTAINER_DATABASE_URL=
PROBE_CONTAINER_S3_ENDPOINT_URL=
NEXT_PUBLIC_PROBE_API_URL=http://localhost:8000
PROBE_TEMPORAL_PORT=7233
PROBE_TEMPORAL_UI_PORT=8233
PROBE_TEMPORAL_ADDRESS=localhost:7233
PROBE_CONTAINER_TEMPORAL_ADDRESS=
PROBE_TEMPORAL_NAMESPACE=probe
PROBE_TEMPORAL_TASK_QUEUE=probe-runs

# Artifact storage. Use "local" outside Compose or any S3-compatible service.
PROBE_ARTIFACT_STORAGE=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=probe-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_TTL=3600
